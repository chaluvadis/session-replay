{
  "name": "@dumb-pipe/ui",
  "private": true,
  "version": "0.1.0",
  "description": "React replay UI for Dumb Pipe session replay",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@dumb-pipe/types": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrweb-player": "^2.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "jsdom": "^26.0.0"
  }
}
