# Dumb Pipe Environment Configuration
# Copy this file to .env and adjust values as needed.
# Never commit actual secrets to version control.

# --- Go Backend ---
SERVER_ADDR=:8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dumbpipe?sslmode=disable

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dumbpipe-chunks
MINIO_USE_SSL=false

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080
